generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// FR1 & FR9: Stores Admin, Teacher, and Parent accounts
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  fullName     String
  passwordHash String
  role         String // "ADMIN", "TEACHER", or "PARENT"
  createdAt    DateTime @default(now())

  classesTaught Class[]        @relation("ClassTeacher")
  childrenLinks ParentChild[]  @relation("ParentAccount")
  notifications Notification[]
}

// FR1: Academic Classes (e.g., Grade 8-A)
model Class {
  id        Int    @id @default(autoincrement())
  name      String @unique
  teacherId Int?
  teacher   User?  @relation("ClassTeacher", fields: [teacherId], references: [id])

  students    Student[]
  attendances Attendance[]
  results     Result[]
  homeworks   Homework[]
}

// FR1: Student Records
model Student {
  id         Int    @id @default(autoincrement())
  rollNumber String @unique
  fullName   String
  classId    Int
  class      Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  parents     ParentChild[]
  attendances Attendance[]
  results     Result[]
  fees        FeeRecord[]
}

// FR2: Links one Parent account to multiple Children
model ParentChild {
  id        Int     @id @default(autoincrement())
  parentId  Int
  studentId Int
  parent    User    @relation("ParentAccount", fields: [parentId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

// FR4: Daily Attendance
model Attendance {
  id        Int     @id @default(autoincrement())
  date      String // Format: YYYY-MM-DD
  status    String // "PRESENT" or "ABSENT"
  studentId Int
  classId   Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
}

// FR5: Exam & Assessment Results
model Result {
  id         Int     @id @default(autoincrement())
  examTitle  String
  marks      Float
  totalMarks Float   @default(100)
  studentId  Int
  classId    Int
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class      Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
}

// FR6: Class Homework
model Homework {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  dueDate     String
  fileUrl     String?
  classId     Int
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

// FR7: Parent Alerts when Homework is Uploaded
model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  isRead    Boolean  @default(false)
  parentId  Int
  parent    User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// FR3: Student Fee Billing, Payments & Dues
model FeeRecord {
  id          Int     @id @default(autoincrement())
  title       String
  totalAmount Float
  paidAmount  Float   @default(0)
  dueDate     String
  studentId   Int
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// FR8: School Circulars & Events
model Circular {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  type      String // "CIRCULAR" or "EVENT"
  eventDate String?
  createdAt DateTime @default(now())
}
